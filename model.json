{
  "kind": "vision",
  "version": "0.1.0",
  "title": "Vision",
  "description": "Task-bound image analysis with explicit remote opt-in, structured results and uncertainty reporting.",
  "repository_url": "https://github.com/HackInvent/bloxmith-vision",
  "bloxsmith_compatibility": ["1.0.9"],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "python_distribution",
      "name": "Pillow",
      "version": ">=10.2"
    },
    {
      "type": "python_distribution",
      "name": "httpx",
      "version": ">=0.28,<1"
    },
    {
      "type": "python_distribution",
      "name": "jsonschema",
      "version": ">=4,<5"
    },
    {
      "type": "manual",
      "name": "Linux; Pillow 10+, httpx 0.28+, jsonschema 4+. OpenAI account/key only for explicitly enabled remote analysis."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "image",
        "title": "Image request",
        "accepts": [
          "text/plain",
          "file/path",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": true,
        "execution_requirement": "required_for_execution"
      },
      {
        "id": 2,
        "name": "task",
        "title": "Analysis task",
        "accepts": [
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "optional"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "result",
        "title": "Structured result",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "evidence",
        "title": "Model evidence",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "issues",
        "title": "Issues / status",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "remote_enabled": false,
    "model": "gpt-4.1-mini-2025-04-14",
    "api_key_ref": "",
    "allowed_root": "",
    "instruction": "Describe the visible scene. Report only supported observations; mark unknown criteria as null.",
    "result_schema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "criteria_met": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "summary",
        "criteria_met"
      ],
      "additionalProperties": false
    },
    "detail": "auto",
    "max_side": 2048,
    "max_pixels": 16777216,
    "max_bytes": 10485760,
    "timeout_sec": 90,
    "max_output_tokens": 2048
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
